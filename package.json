{
  "name": "@quickbi/open-sdk",
  "private": true,
  "description": "Quick BI NodeJS Open SDK",
  "keywords": [
    "NodeJS",
    "Quick BI"
  ],
  "license": "MIT",
  "author": "Quick BI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quick-bi/open-sdk.git"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --filter='./packages/*' run build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version": "changeset version && tsx scripts/sync-template-deps.ts && pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@quickbi/qbi-dev-tools": "workspace:*",
    "@rslib/core": "^0.23.2",
    "@types/node": "^24.10.1",
    "create-qbi-app": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "pnpm@10.6.3",
  "pnpm": {
    "overrides": {
      "@quickbi/qbi-dev-tools": "workspace:*",
      "create-qbi-app": "workspace:*"
    }
  }
}
